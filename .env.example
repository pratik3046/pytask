# ==============================================================================
# LinkedIn Automation Credentials
# ==============================================================================
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# ==============================================================================
# Gmail SMTP / IMAP Configuration (Requires 2-Step Verification App Password)
# ==============================================================================
GMAIL_EMAIL=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Optional system routing
ADMIN_EMAIL=admin_outreach@example.com
TEAM_LEAD_EMAIL=teamlead_c2c@example.com

# ==============================================================================
# Generative AI Model Configurations (Primary with Automatic Fallbacks)
# ==============================================================================
# Primary LLM for Resume Customization
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Secondary Fallback LLM (Value Propositions & Customization)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Tertiary Fallback LLM
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
